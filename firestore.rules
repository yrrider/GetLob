rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(pairId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.members;
    }

    // Each user can only touch their own profile (pairId + FCM token).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Pairs and invites are created/joined only through Cloud Functions (admin SDK).
    match /invites/{code} {
      allow read, write: if false;
    }

    match /pairs/{pairId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      // Pair members may only save display settings and canvasClearedAt
      allow update: if request.auth != null && request.auth.uid in resource.data.members &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings', 'canvasClearedAt']);
      allow create, delete: if false;

      match /messages/{id} {
        allow read, delete: if isMember(pairId);
        allow create: if isMember(pairId) &&
          request.resource.data.from == request.auth.uid &&
          (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);
        allow update: if false;
      }

      match /games/{id} {
        allow read, write: if isMember(pairId);
      }
    }
  }
}
