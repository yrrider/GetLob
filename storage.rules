rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(pairId) {
      return request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/pairs/$(pairId)).data.members;
    }

    match /pairs/{pairId}/{allPaths=**} {
      allow read, delete: if isMember(pairId);
      allow write: if isMember(pairId) && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
